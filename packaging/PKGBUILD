# AximOS's desktop, as Arch packages: libgui and what it shares, its apps, and the
# desktop itself, wm, with its log-in screen. make packages builds them in a clean
# chroot from a tarball of the tree, aximos.tar.gz, beside this.

pkgbase=aximos
pkgname=(aximos-libgui aximos-apps aximos-desktop aximos-installer aximos-keyring)
pkgver=0.1.0 # make packages sets it from git
pkgrel=1
pkgdesc='AximOS desktop'
arch=(x86_64)
url='https://github.com/connordavishunter-sys/AximOS-arch'
license=(custom)
makedepends=(wlroots0.20 scenefx wayland wayland-protocols libinput libxkbcommon pixman libdrm libpulse pam stb
             mpg123 lame flac libvorbis libogg opus faad2 faac libxcrypt)
source=(aximos.tar.gz keyring.tar.gz)
sha256sums=(SKIP SKIP)

build() {
    make -C aximos PREFIX=/usr
}

# Everything's installed once, then shared out between the packages.
_install_all() {
    [[ -d $srcdir/staged ]] || make -C "$srcdir/aximos" PREFIX=/usr DESTDIR="$srcdir/staged" install
}

_take() {
    local path
    for path; do
        mkdir -p "$pkgdir/$(dirname "$path")"
        cp -a "$srcdir/staged/$path" "$pkgdir/$path"
    done
}

package_aximos-libgui() {
    pkgdesc='AximOS libgui: the toolkit its apps draw with, as Wayland clients, and its sound library'
    depends=(wayland libxkbcommon libpulse libxcrypt mpg123 lame flac libvorbis libogg opus faad2 faac libwebp ttf-dejavu)
    _install_all
    _take usr/lib/libgui.so usr/lib/libaximos.so usr/lib/libaudio.so usr/lib/aximos/codecs usr/include/aximos \
        usr/share/aximos/fonts usr/share/aximos/icons
}

package_aximos-apps() {
    pkgdesc='AximOS apps: Terminal, Files, Editor, Paint, Viewer, Player, Calculator, Settings, Tasks and Snake'
    depends=(aximos-libgui systemd-libs udisks2) # udisks2 mounts drives for Files
    _install_all
    _take usr/lib/aximos/apps usr/bin/run usr/bin/notify usr/share/aximos/example_music
    rm "$pkgdir/usr/lib/aximos/apps/System/installer" # aximos-installer's
}

package_aximos-desktop() {
    pkgdesc='AximOS desktop: wm, a Wayland compositor on wlroots, with XWayland, and its log-in screen'
    depends=(aximos-libgui aximos-apps aximos-keyring wlroots0.20 scenefx libinput pixman libdrm pam systemd-libs xorg-xwayland
             pipewire-pulse bluez polkit pacman-contrib fakeroot)
    optdepends=('greetd: to log in with wm'"'"'s own log-in screen' 'networkmanager: for the network panel')
    backup=(etc/pam.d/aximos-lock)
    install=aximos-desktop.install
    _install_all
    _take usr/bin/wm usr/bin/aximos-update usr/lib/aximos/login usr/share/aximos/wallpapers usr/share/wayland-sessions \
        usr/lib/systemd/logind.conf.d usr/share/polkit-1/actions/org.aximos.update.policy etc/pam.d/aximos-lock \
        etc/profile.d/aximos-recovery.sh
}

package_aximos-installer() {
    pkgdesc='AximOS installer: puts AximOS from its live ISO onto a drive, beside other systems or in their place'
    depends=(aximos-libgui sudo arch-install-scripts rsync gptfdisk parted dosfstools e2fsprogs limine efibootmgr)
    _install_all
    _take usr/lib/aximos/apps/System/installer usr/bin/aximos-install
}

package_aximos-keyring() {
    pkgdesc="AximOS keyring: the key AximOS's packages are signed with, for pacman to trust"
    arch=(any)
    depends=(pacman)
    install=aximos-keyring.install
    install -Dm644 -t "$pkgdir/usr/share/pacman/keyrings" keyring/aximos.gpg keyring/aximos-trusted keyring/aximos-revoked
}
